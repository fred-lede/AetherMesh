{
  "channels": {
    "telegram": {
      "enabled": false,
      "bot_token": "123456789:AAAA-your-bot-token-here",
      "chat_id": "-1001234567890",
      "min_severity": "warning"
    },
    "synology_chat": {
      "enabled": false,
      "webhook_url": "https://your-nas:5001/webapi/entry.cgi?api=SYNO.Chat.External&method=incoming&version=2&token=...",
      "min_severity": "warning"
    }
  },
  "watchdog": {
    "enabled": true,
    "interval_s": 30,
    "health_timeout_s": 10,
    "hang_failures_to_alert": 3,
    "startup_grace_s": 180,
    "exclude_services": [],
    "rules": {
      "service_rss_mb": {"warn": 4096, "critical": 8192},
      "disk_free_pct": {"warn": 15.0, "critical": 5.0}
    },
    "auto_restart": {
      "enabled": false,
      "restart_after_s": 60,
      "cooldown_s": 1800,
      "max_per_day": 4,
      "exclude": ["task_worker"]
    },
    "ollama_deep_check": {
      "enabled": true,
      "base_url": "http://127.0.0.1:11434",
      "interval_s": 120,
      "timeout_s": 30,
      "model": "",
      "failures_to_alert": 2
    }
  }
}
