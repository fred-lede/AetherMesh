[Unit]
Description=AetherMesh Ollama Worker GPU0
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/ollama
EnvironmentFile=/etc/default/aiih-ollama-gpu0
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=3
User=ollama
Group=ollama

[Install]
WantedBy=multi-user.target
