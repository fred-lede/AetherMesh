[Unit]
Description=AetherMesh Node Agent
After=network-online.target aiih-worker-agent.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT_DIR__
EnvironmentFile=__ROOT_DIR__/.env
ExecStart=__ROOT_DIR__/.venv/bin/python -m uvicorn node.node_agent:app --host 0.0.0.0 --port 9400
Restart=always
RestartSec=5
User=fred
Group=fred

[Install]
WantedBy=multi-user.target
