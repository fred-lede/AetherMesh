[Unit]
Description=AetherMesh Worker Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT_DIR__
EnvironmentFile=__ROOT_DIR__/.env
ExecStart=__ROOT_DIR__/.venv/bin/python -m uvicorn node.worker_agent:app --host 0.0.0.0 --port 9300 --ws-ping-interval 20 --ws-ping-timeout 120
Restart=always
RestartSec=5
User=fred
Group=fred

[Install]
WantedBy=multi-user.target
