[Unit]
Description=AI Inference Hub Worker Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fred/ai/ai_inference_hub
EnvironmentFile=/home/fred/ai/ai_inference_hub/.env
ExecStart=/home/fred/ai/ai_inference_hub/.venv/bin/python -m uvicorn node.worker_agent:app --host 0.0.0.0 --port 9300
Restart=always
RestartSec=5
User=fred
Group=fred

[Install]
WantedBy=multi-user.target
