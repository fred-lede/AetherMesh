<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.aiih.worker</string>

    <key>ProgramArguments</key>
    <array>
      <string>__ROOT_DIR__/.venv/bin/python</string>
      <string>-m</string>
      <string>runtime.launcher</string>
      <string>start</string>
      <string>node_agent</string>
      <string>worker_agent</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ROOT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>AIIH_CONTROL_IP</key>
      <string>192.168.1.201</string>
      <key>PATH</key>
      <string>__ROOT_DIR__/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__ROOT_DIR__/logs/launchd-worker.out.log</string>

    <key>StandardErrorPath</key>
    <string>__ROOT_DIR__/logs/launchd-worker.err.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
  </dict>
</plist>
