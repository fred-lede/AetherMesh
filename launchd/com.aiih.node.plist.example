<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.aiih.node</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-lc</string>
      <string>cd __ROOT_DIR__ &amp;&amp; ./scripts/start_cluster_macos.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ROOT_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__ROOT_DIR__/logs/launchd-aiih-node.out.log</string>

    <key>StandardErrorPath</key>
    <string>__ROOT_DIR__/logs/launchd-aiih-node.err.log</string>
  </dict>
</plist>
