# Ubuntu Tesla P40 remote node example
# Example node: 192.168.1.123
# Replace CONTROL_PLANE_HOST_IP and REDIS_HOST_IP before use.
# AIIH_NODE_ID must be unique in the cluster.

AIIH_HOST=0.0.0.0
AIIH_CONTROL_URL=http://<CONTROL_PLANE_HOST_IP>:9200
AIIH_ROUTER_URL=http://<CONTROL_PLANE_HOST_IP>:8001
AIIH_METRICS_URL=http://<CONTROL_PLANE_HOST_IP>:9100
AIIH_REDIS_URL=redis://<REDIS_HOST_IP>:6379/0

AIIH_NODE_ID=node-p40-01
AIIH_NODE_IP=192.168.1.123
AIIH_WORKER_RPC_PORT=9300
AIIH_NODE_PORT=9400
AIIH_HEARTBEAT_INTERVAL=15
AIIH_STALE_AFTER=45
AIIH_REQUEST_TIMEOUT=300
AIIH_MAX_WORKER_QUEUE=8
AIIH_MAX_TASK_RETRIES=3
AIIH_DASHBOARD_REFRESH=5

OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
