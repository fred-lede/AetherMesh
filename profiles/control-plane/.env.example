# GENERATED FILE: do not edit directly.
# Source: /.env.example
# Update source then run: python scripts/sync_env_examples.py

# AetherMesh example environment
# Copy to .env and adjust only the values you need.
#
# Role labels:
#   [all]     — needed on both control plane AND worker nodes
#   [control] — only needed on the main AIIH control plane host
#   [worker]  — only needed on remote GPU worker nodes
#   [cloud]   — optional, for cloud provider fallback

# ── Core service ports ──────────────────────────────────────────
# [control] Ports for services that run on the control plane host
AIIH_HOST=0.0.0.0
AIIH_ROUTER_PORT=8001
AIIH_ANTHROPIC_PORT=8002
AIIH_DASHBOARD_PORT=9001
AIIH_METRICS_PORT=9100
AIIH_CONTROL_PORT=9200
AIIH_WORKER_RPC_PORT=9300
AIIH_NODE_PORT=9400

# ── Internal service URLs ───────────────────────────────────────
# [control] Use 127.0.0.1 when services are on the same machine
# [worker]  Point to the control plane host's LAN IP
AIIH_CONTROL_URL=http://127.0.0.1:9200
AIIH_ROUTER_URL=http://127.0.0.1:8001
AIIH_METRICS_URL=http://127.0.0.1:9100

# ── Redis ───────────────────────────────────────────────────────
# [all] If Redis runs on the control plane, use its LAN IP on workers
AIIH_REDIS_URL=redis://127.0.0.1:6379/0

# ── Config directory ────────────────────────────────────────────
# [all] Leave blank to use the repo's config/ directory
AIIH_CONFIG_DIR=

# ── Cluster behavior ────────────────────────────────────────────
# [all] Tune heartbeat intervals, timeouts, and retry thresholds
AIIH_REQUEST_TIMEOUT=300
AIIH_HEARTBEAT_INTERVAL=15
AIIH_STALE_AFTER=45
AIIH_MAX_WORKER_QUEUE=8
AIIH_MAX_TASK_RETRIES=3
AIIH_WORKER_DEGRADE_AFTER_ERRORS=2
AIIH_WORKER_DEGRADE_COOLDOWN=30
AIIH_PROVIDER_COOLDOWN=180

# ── Rate limiting ───────────────────────────────────────────────
# [control] Set AIIH_RATE_LIMIT_ENABLED=true to enable per-IP rate limiting
AIIH_RATE_LIMIT_ENABLED=false
AIIH_RATE_LIMIT_PER_MINUTE=60
AIIH_RATE_LIMIT_BURST=10

# ── Dashboard ───────────────────────────────────────────────────
# [control] Dashboard refresh rate and authentication
AIIH_DASHBOARD_REFRESH=5
AIIH_DASHBOARD_AUTH_ENABLED=false
AIIH_DASHBOARD_AUTH_USERNAME=admin
AIIH_DASHBOARD_AUTH_PASSWORD=
AIIH_DETAIL_REFRESH=30

# ── Task pruning ────────────────────────────────────────────────
# [control] Auto-cleanup settings for completed/failed tasks
AIIH_TASK_PRUNE_ENABLED=true
AIIH_TASK_PRUNE_HOUR=3
AIIH_TASK_PRUNE_MINUTE=30
AIIH_TASK_RETENTION_HOURS=72
AIIH_TASK_PRUNE_STATUSES=completed,failed

# ── Server tools & web search ───────────────────────────────────
# [control] Tool server mode, auto web search, and search provider keys
AIIH_DEBUG_TOOL_CALLS=false
AIIH_SERVER_TOOL_MODE=reject
AIIH_WEB_SERVER_TOOLS_ENABLED=false
AIIH_WEB_TOOLS_AUTO_SEARCH=false
AIIH_WEB_TOOL_TIMEOUT=15
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
AIIH_WEB_SEARCH_MAX_RESULTS=5

# ── Node identity ───────────────────────────────────────────────
# [all] Must be unique per machine in the cluster
AIIH_NODE_ID=node-control-01
# [all] Override to avoid Linux loopback addresses like 127.0.1.1
AIIH_NODE_IP=

# ── Task worker ─────────────────────────────────────────────────
# [control] ID for the async queue consumer (only relevant if using async tasks)
AIIH_TASK_WORKER_ID=worker-1

# ── HTTP connection pool ────────────────────────────────────────
# [all] Performance tuning for high-concurrency scenarios
AIIH_HTTP_POOL_CONNECTIONS=20
AIIH_HTTP_POOL_MAXSIZE=10
AIIH_HTTP_MAX_RETRIES=3
AIIH_HTTP_RETRY_BACKOFF=0.5

# ── Cloud provider retry behavior ───────────────────────────────
# [control] Retry before triggering fallback + cooldown
AIIH_CLOUD_MAX_RETRIES=2
AIIH_CLOUD_BACKOFF_FACTOR=2.0
NVIDIA_NIM_MAX_RETRIES=2
NVIDIA_NIM_BACKOFF_FACTOR=2.0

# ── External provider configuration ─────────────────────────────
# [cloud] Leave blank if you are only using local Ollama workers.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=

NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_TIMEOUT=120
NVIDIA_NIM_MIN_INTERVAL=1.5

OLLAMA_CLOUD_API_BASE=https://ollama.com
OLLAMA_CLOUD_API_KEY=

# ── Cloud fallback ──────────────────────────────────────────────
# [control] Fallback Ollama instance when no local worker matches
# If AIIH and Ollama run on the same host, http://127.0.0.1:11434 is correct.
AIIH_OLLAMA_FALLBACK_MODEL=
AIIH_OLLAMA_FALLBACK_BASE_URL=
