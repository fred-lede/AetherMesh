# GENERATED FILE: do not edit directly.
# Source: /.env.example
# Update source then run: python scripts/sync_env_examples.py

# AetherMesh example environment
# Copy to .env and adjust only the values you need.

# Core service host/ports
AIIH_HOST=0.0.0.0
AIIH_ROUTER_PORT=8001
AIIH_ANTHROPIC_PORT=8002
AIIH_DASHBOARD_PORT=9001
AIIH_METRICS_PORT=9100
AIIH_CONTROL_PORT=9200
AIIH_WORKER_RPC_PORT=9300
AIIH_NODE_PORT=9400

# Internal service URLs
AIIH_CONTROL_URL=http://127.0.0.1:9200
AIIH_ROUTER_URL=http://127.0.0.1:8001
AIIH_METRICS_URL=http://127.0.0.1:9100

# Redis
# If Redis runs inside WSL on the same machine, keep 127.0.0.1 unless your setup requires a different bind address.
AIIH_REDIS_URL=redis://127.0.0.1:6379/0

# Config files
# Leave blank to use the repo's config/ directory.
AIIH_CONFIG_DIR=

# Cluster behavior
AIIH_REQUEST_TIMEOUT=300
AIIH_HEARTBEAT_INTERVAL=15
AIIH_STALE_AFTER=45
AIIH_MAX_WORKER_QUEUE=8
AIIH_MAX_TASK_RETRIES=3
AIIH_WORKER_DEGRADE_AFTER_ERRORS=2
AIIH_WORKER_DEGRADE_COOLDOWN=30
AIIH_PROVIDER_COOLDOWN=180

# Rate limiting (per IP) - set AIIH_RATE_LIMIT_ENABLED=true to enable
AIIH_RATE_LIMIT_ENABLED=false
AIIH_RATE_LIMIT_PER_MINUTE=60
AIIH_RATE_LIMIT_BURST=10

AIIH_DASHBOARD_REFRESH=5
# Dashboard authentication is disabled by default for local development.
# Set enabled=true and choose a strong password when exposing the dashboard.
AIIH_DASHBOARD_AUTH_ENABLED=false
AIIH_DASHBOARD_AUTH_USERNAME=admin
AIIH_DASHBOARD_AUTH_PASSWORD=
AIIH_DETAIL_REFRESH=30
AIIH_TASK_PRUNE_ENABLED=true
AIIH_TASK_PRUNE_HOUR=3
AIIH_TASK_PRUNE_MINUTE=30
AIIH_TASK_RETENTION_HOURS=72
AIIH_TASK_PRUNE_STATUSES=completed,failed
# Enable verbose tool_calls diagnostics when troubleshooting. Requires DEBUG log level to emit.
AIIH_DEBUG_TOOL_CALLS=false
# Must be unique per node in a multi-node cluster.
AIIH_NODE_ID=node-control-01

# Task worker ID (for multiple async workers)
AIIH_TASK_WORKER_ID=worker-1
# Optional override to avoid Linux loopback addresses like 127.0.1.1.
AIIH_NODE_IP=

# HTTP connection pool (for performance under high concurrency)
# Number of connection pools to keep
AIIH_HTTP_POOL_CONNECTIONS=20
# Max connections per pool
AIIH_HTTP_POOL_MAXSIZE=10
# Max retries for transient errors (429, 500-504)
AIIH_HTTP_MAX_RETRIES=3
# Backoff factor for retries (seconds)
AIIH_HTTP_RETRY_BACKOFF=0.5

# External provider configuration
# Leave blank if you are only using local Ollama workers.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=

NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
# NIM free tier safety: 1-by-1 queue at ~40 RPM.
# Keep this long enough for NIM cold starts; fallback handles real timeouts.
NVIDIA_NIM_TIMEOUT=120
NVIDIA_NIM_MIN_INTERVAL=1.5

OLLAMA_CLOUD_API_BASE=https://ollama.com
OLLAMA_CLOUD_API_KEY=

# Cloud fallback target for Anthropic/OpenAI-compatible chat routes.
# Leave blank to use config/routing_rules.yaml, or set an explicit Ollama host.
# If AIIH and Ollama run on the same host, http://127.0.0.1:11434 is correct.
# If AIIH should fallback to another Ollama host, set that remote Ollama base URL.
AIIH_OLLAMA_FALLBACK_MODEL=
AIIH_OLLAMA_FALLBACK_BASE_URL=
