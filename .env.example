# AetherMesh example environment
# Copy to .env and adjust only the values you need.
#
# Role labels:
#   [all]     — needed on both control plane AND worker nodes
#   [control] — only needed on the main AIIH control plane host
#   [worker]  — only needed on remote GPU worker nodes
#   [cloud]   — optional, for cloud provider fallback

# ── Core service ports ──────────────────────────────────────────
# [control] Ports for services that run on the control plane host
AIIH_HOST=0.0.0.0
AIIH_ROUTER_PORT=8001
AIIH_ANTHROPIC_PORT=8002
AIIH_DASHBOARD_PORT=9001
AIIH_METRICS_PORT=9100
AIIH_CONTROL_PORT=9200
AIIH_WORKER_RPC_PORT=9300
AIIH_NODE_PORT=9400

# ── TLS / SSL ────────────────────────────────────────────────────
# [all] Set both paths to enable HTTPS for all AIIH services (launcher,
#   dashboard, routers, agents). The internal worker ↔ Ollama connections
#   remain HTTP (Ollama does not use TLS by default).
# Generate self-signed certs:  ./scripts/gen-certs.sh
# AIIH_SSL_CERTFILE=/etc/aiih/certs/server.crt
# AIIH_SSL_KEYFILE=/etc/aiih/certs/server.key
# IMPORTANT: When TLS is enabled, update AIIH_CONTROL_URL / AIIH_ROUTER_URL
#   below to use https:// instead of http://

# ── Internal service URLs ───────────────────────────────────────
# [control] Use 127.0.0.1 when services are on the same machine
# [worker]  Point to the control plane host's LAN IP
# NOTE: Change http:// → https:// after enabling TLS (set AIIH_SSL_CERTFILE + KEYFILE)
AIIH_CONTROL_URL=http://127.0.0.1:9200
AIIH_ROUTER_URL=http://127.0.0.1:8001
AIIH_METRICS_URL=http://127.0.0.1:9100

# ── Redis ───────────────────────────────────────────────────────
# [all] If Redis runs on the control plane, use its LAN IP on workers
AIIH_REDIS_URL=redis://127.0.0.1:6379/0

# ── Config directory ────────────────────────────────────────────
# [all] Leave blank to use the repo's config/ directory
AIIH_CONFIG_DIR=

# ── Cluster behavior ────────────────────────────────────────────
# [all] Tune heartbeat intervals, timeouts, and retry thresholds
AIIH_REQUEST_TIMEOUT=120
# Maximum time to wait for the next chunk from a streaming provider. Agent
# workloads can pause for model thinking, tool-call generation, or cold loads.
AIIH_STREAM_READ_TIMEOUT=30
# Unload other Ollama models on a worker before loading a different model.
AIIH_OLLAMA_EVICT_ON_MODEL_SWITCH=true
# Seconds to wait for older active requests before a worker switches models.
AIIH_OLLAMA_MODEL_SWITCH_WAIT_TIMEOUT=900
# Reserve VRAM for KV cache and runtime buffers during model admission.
AIIH_VRAM_ADMISSION_ENABLED=true
AIIH_VRAM_RESERVE_MB=4096
AIIH_QUEUE_TIMEOUT=120
AIIH_HEARTBEAT_INTERVAL=15
AIIH_STALE_AFTER=45
AIIH_MAX_WORKER_QUEUE=8
#   When all workers for a model hit this cap, new requests get HTTP 429
#   (worker_queue_full). Retry will route to the next available worker via
#   load balancer. Increase for longer queue tolerance (more waiting, fewer
#   rejections); decrease for faster rejection so clients can retry sooner.
AIIH_WORKER_ASSIGNMENT_TTL=900
#   Maximum seconds a sync worker assignment may remain in-flight without a
#   release. If a router process crashes mid-request, the control plane reclaims
#   expired assignments so queue_size cannot stay inflated forever.
AIIH_MAX_TASK_RETRIES=3
AIIH_WORKER_DEGRADE_AFTER_ERRORS=2
AIIH_WORKER_DEGRADE_COOLDOWN=30
AIIH_PROVIDER_COOLDOWN=180

# ── API key authentication ──────────────────────────────────────
# [all] Set to require x-api-key header on all router endpoints (8001, 8002).
#   Clients must send:  x-api-key: <your-key>
#   or:  Authorization: Bearer <your-key>
# Leave empty to disable (no auth check).
AIIH_API_KEY=

# ── Admin bootstrap (first-run) ─────────────────────────────────
# [control] Used to create the initial admin account in the database.
# Only takes effect if no admin user exists yet. After first startup,
# these can be removed.
AIIH_ADMIN_EMAIL=
AIIH_ADMIN_PASSWORD=
# Path for the SQLite database (default: config/aiih.db)
# AIIH_DB_PATH=

# ── Rate limiting ───────────────────────────────────────────────
# [control] Set AIIH_RATE_LIMIT_ENABLED=true to enable per-IP rate limiting
AIIH_RATE_LIMIT_ENABLED=false
AIIH_RATE_LIMIT_PER_MINUTE=60
AIIH_RATE_LIMIT_BURST=10

# ── Dashboard ───────────────────────────────────────────────────
# [control] Dashboard refresh rate and authentication
AIIH_DASHBOARD_REFRESH=5
AIIH_DASHBOARD_AUTH_ENABLED=false
AIIH_DASHBOARD_AUTH_USERNAME=admin
AIIH_DASHBOARD_AUTH_PASSWORD=
AIIH_DETAIL_REFRESH=30

# ── Task pruning ────────────────────────────────────────────────
# [control] Auto-cleanup settings for completed/failed tasks
AIIH_TASK_PRUNE_ENABLED=true
AIIH_TASK_PRUNE_HOUR=3
AIIH_TASK_PRUNE_MINUTE=30
AIIH_TASK_RETENTION_HOURS=72
AIIH_TASK_PRUNE_STATUSES=completed,failed

# ── Server tools & web search ───────────────────────────────────
# [control] Tool server mode, auto web search, and search provider keys
AIIH_DEBUG_TOOL_CALLS=false
AIIH_DEBUG_RESPONSES=false
AIIH_SERVER_TOOL_MODE=reject
AIIH_WEB_SERVER_TOOLS_ENABLED=false
AIIH_WEB_TOOLS_AUTO_SEARCH=false
AIIH_WEB_TOOL_TIMEOUT=15
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
AIIH_WEB_SEARCH_MAX_RESULTS=5

# ── Node identity ───────────────────────────────────────────────
# [all] Must be unique per machine in the cluster
AIIH_NODE_ID=node-01
# [all] Override to avoid Linux loopback addresses like 127.0.1.1
AIIH_NODE_IP=

# ── Task worker ─────────────────────────────────────────────────
# [control] ID for the async queue consumer (only relevant if using async tasks)
AIIH_TASK_WORKER_ID=worker-1

# ── HTTP connection pool ────────────────────────────────────────
# [all] Performance tuning for high-concurrency scenarios
AIIH_HTTP_POOL_CONNECTIONS=20
AIIH_HTTP_POOL_MAXSIZE=10
AIIH_HTTP_MAX_RETRIES=3
AIIH_HTTP_RETRY_BACKOFF=0.5

# ── Cloud provider retry behavior ───────────────────────────────
# [control] Retry before triggering fallback + cooldown
AIIH_CLOUD_MAX_RETRIES=2
AIIH_CLOUD_BACKOFF_FACTOR=2.0
NVIDIA_NIM_MAX_RETRIES=2
NVIDIA_NIM_BACKOFF_FACTOR=2.0

# ── External provider configuration ─────────────────────────────
# [cloud] Leave blank if you are only using local Ollama workers.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=

NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_TIMEOUT=120
NVIDIA_NIM_MIN_INTERVAL=1.5

OLLAMA_CLOUD_API_BASE=https://ollama.com
OLLAMA_CLOUD_API_KEY=

# ── Local TTS (XTTS-v2) ──────────────────────────────────────────
# [control] Enable local text-to-speech via XTTS-v2 on GPU
# Requires: pip install -e ".[tts]"
AIIH_TTS_ENABLED=false
AIIH_TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
# Device: "cuda" or "cuda:0"/"cuda:1" for multi-GPU, "cpu" for CPU-only
AIIH_TTS_DEVICE=cuda
AIIH_TTS_VOICES_DIR=data/voices
AIIH_TTS_MODELS_DIR=data/tts_models
# Model precision: fp32 (default), fp16 (~2.4 GB VRAM, ~2x faster)
AIIH_TTS_DTYPE=fp32

# ── Local ASR (faster-whisper) ──────────────────────────────
# [control] Enable local speech-to-text via faster-whisper on GPU
# Requires: pip install -r requirements-asr.txt
AIIH_ASR_ENABLED=false
AIIH_ASR_MODEL=large-v3
# Device: "cuda" or "cpu" only (NOT "cuda:0" — ctranslate2 format)
AIIH_ASR_DEVICE=cuda
# GPU index when device=cuda (0=first, 1=second, etc.)
AIIH_ASR_DEVICE_INDEX=0
AIIH_ASR_COMPUTE_TYPE=float16
AIIH_ASR_MODELS_DIR=data/asr_models

# ── Local Image Gen (Ollama, macOS) ─────────────────────────
# [control] Enable text-to-image via Ollama on remote macOS node
AIIH_IMAGE_GEN_ENABLED=false
AIIH_IMAGE_GEN_DEFAULT_MODEL=x/z-image-turbo:fp8
AIIH_IMAGE_GEN_DEFAULT_WORKER=http://192.168.1.100:11434

# ── Cloud fallback ──────────────────────────────────────────────
# [control] Fallback Ollama instance when no local worker matches
# If AIIH and Ollama run on the same host, http://127.0.0.1:11434 is correct.
AIIH_OLLAMA_FALLBACK_MODEL=
AIIH_OLLAMA_FALLBACK_BASE_URL=
